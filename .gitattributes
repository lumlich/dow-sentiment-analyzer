# ----------------------------------------------------
# Global: normalize text; default conversion enabled
# ----------------------------------------------------
*           text=auto

# ----------------------------------------------------
# Source & text files: enforce LF on checkout too
# ----------------------------------------------------
*.rs        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.env.example text eol=lf
*.sh        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# ----------------------------------------------------
# Windows shell scripts: keep CRLF (expected by host)
# ----------------------------------------------------
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ----------------------------------------------------
# Binary assets (no EOL conversion, no diffs)
# ----------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.tar       binary
*.tgz       binary
*.wasm      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.exe       binary
*.dll       binary
*.pdb       binary
